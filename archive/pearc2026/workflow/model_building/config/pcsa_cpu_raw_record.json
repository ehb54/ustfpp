{
    "data_file":"../../datasets/pcsa_cleaned.csv.gz",
    "method": "pcsa",
    "feature_space": "raw",
    "columns_file": "./columns_files/raw_config_columns_pcsa.txt",
    "architectures": [[64, 32], [128, 64]],
    "scalers": ["standard", "minmax"],
    "optimizers": ["adam", "rmsprop"],
    "batch_sizes": [64, 128],
    "activations": ["relu", "elu"],
    "dropout_rates": [0.2, 0.3],
    "epochs": 100,
    "patience": 10,
    "training_fraction": 0.70,
    "validation_fraction": 0.15,
    "temporal_split": false,
    "time_column": "submitTime",
    "target_variable": "CPUTime",
    "mirroredstrategy": false,
    "gpu_mem_grow": true,
    "output_dir": "./results/pcsa/cpu/raw/record"
}
